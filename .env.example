# Copy to `.env`. Without LAB_LIVE=1 everything runs offline (deterministic, no API key).
LAB_LIVE=0

# Main model: openai | custom | gemini | anthropic | ollama | openrouter
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Optional judge model for benchmark quality (defaults to the main model)
# JUDGE_PROVIDER=openai
# JUDGE_MODEL=gpt-4o-mini

# Provider credentials (only the one you use is needed)
OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# CUSTOM_BASE_URL=http://localhost:8000/v1
# CUSTOM_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Memory knobs
COMPACT_THRESHOLD_TOKENS=800
COMPACT_KEEP_MESSAGES=4
PROFILE_CONFIDENCE_THRESHOLD=0.6
PROFILE_MAX_INTERESTS=8
